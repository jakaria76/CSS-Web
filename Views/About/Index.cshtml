@model CSS.ViewModels.AboutVM

@{
    ViewData["Title"] = "About Us";
    var missionPoints = Model.MissionPoints ?? new List<CSS.Models.MissionPoint>();
    var whatWeDoItems = Model.whatWeDoItems ?? new List<CSS.Models.WhatWeDoItem>();
    var advisors = Model.Advisors ?? new List<CSS.Models.Advisor>();
    var previousPresidents = Model.PreviousPresidents ?? new List<CSS.Models.PreviousPresident>();
    var leadership = Model.Leadership ?? new List<CSS.Models.LeadershipMember>();
    var stories = Model.OurStoryList ?? new List<CSS.Models.OurStory>();
}

<link rel="stylesheet" href="~/css/about.css" asp-append-version="true" />

<!-- HERO -->
<section class="about-hero">
    <div class="about-hero-inner">
        <div class="about-breadcrumb">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <span>/</span>
            <span>About Us</span>
        </div>
        <h1 class="about-hero-title">About Conscious Student Society</h1>
        <p class="about-hero-subtitle">সচেতন ছাত্র সমাজ • Committed to Education, Humanity &amp; Social Welfare</p>
    </div>
</section>

<div class="container pb-5">

    <!-- ORGANIZATION OVERVIEW -->
    <section class="about-section">
        <div class="about-section-header">
            <div>
                <div class="about-section-kicker"><i class="fa-solid fa-building-columns"></i> Who We Are</div>
                <h2 class="about-section-title">Organization Overview</h2>
            </div>
        </div>

        @if (Model.Overview != null)
        {
            <div class="about-card">
                <div class="about-overview-grid">
                    <div class="d-flex flex-column justify-content-center">
                        <p class="about-overview-text">@Model.Overview.Description</p>
                    </div>
                    <div class="about-meta-panel">
                        <div class="about-meta-item">
                            <div class="about-meta-label">Founded Year</div>
                            <div class="about-meta-value">@Model.Overview.FoundedYear</div>
                        </div>
                        <div class="about-meta-item">
                            <div class="about-meta-label">Core Purpose</div>
                            <div class="about-meta-value">@Model.Overview.Purpose</div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="about-empty">
                <i class="fa-regular fa-building d-block fs-4 mb-2"></i>
                Organization overview details will be published soon.
            </div>
        }
    </section>

    <!-- OUR MISSION -->
    <section class="about-section">
        <div class="about-section-header">
            <div>
                <div class="about-section-kicker"><i class="fa-solid fa-bullseye"></i> Direction</div>
                <h2 class="about-section-title">Our Mission</h2>
            </div>
        </div>

        @if (missionPoints.Any())
        {
            <div class="about-card">
                <ul class="about-mission-list" id="missionList">
                    @for (int i = 0; i < missionPoints.Count; i++)
                    {
                        <li class="about-mission-item mission-item @(i >= 4 ? "d-none" : "")">
                            <span class="about-mission-icon"><i class="fa-solid fa-check"></i></span>
                            <span>@missionPoints[i].Text</span>
                        </li>
                    }
                </ul>

                @if (missionPoints.Count > 4)
                {
                    <div class="text-center">
                        <button type="button" id="toggleMissionBtn" class="about-toggle-btn">
                            <span>Show More</span>
                            <i class="fa-solid fa-chevron-down"></i>
                        </button>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="about-empty">Mission points have not been added yet.</div>
        }
    </section>

    <!-- WHAT WE DO -->
    <section class="about-section">
        <div class="about-section-header">
            <div>
                <div class="about-section-kicker"><i class="fa-solid fa-hands-holding-circle"></i> Initiatives</div>
                <h2 class="about-section-title">What We Do</h2>
            </div>
        </div>

        @if (whatWeDoItems.Any())
        {
            <div class="row g-4" id="whatWeDoList">
                @for (int i = 0; i < whatWeDoItems.Count; i++)
                {
                    var item = whatWeDoItems[i];
                    var excerpt = !string.IsNullOrWhiteSpace(item.Description) && item.Description.Length > 90
                        ? item.Description.Substring(0, 90) + "..."
                        : item.Description;

                    <div class="col-lg-3 col-md-4 col-sm-6 whatwedo-item @(i >= 4 ? "d-none" : "")">
                        <div class="about-item-card">
                            <div class="about-card-img-wrap">
                                @if (item.ImageData != null && item.ImageData.Length > 0)
                                {
                                    <img src="data:image/jpeg;base64,@Convert.ToBase64String(item.ImageData)" class="about-card-img" alt="@item.Title" />
                                }
                                else
                                {
                                    <div class="about-card-placeholder"><i class="fa-solid fa-image"></i></div>
                                }
                            </div>
                            <div class="about-card-body">
                                <h5 class="about-card-title">@item.Title</h5>
                                @if (!string.IsNullOrWhiteSpace(excerpt))
                                {
                                    <p class="about-card-excerpt">@excerpt</p>
                                }
                                <a asp-action="WhatWeDoDetails" asp-route-id="@item.Id" class="about-card-btn">
                                    <span>View Details</span>
                                    <i class="fa-solid fa-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (whatWeDoItems.Count > 4)
            {
                <div class="text-center">
                    <button type="button" class="about-toggle-btn" id="toggleWhatWeDo">
                        <span>Show More</span>
                        <i class="fa-solid fa-chevron-down"></i>
                    </button>
                </div>
            }
        }
        else
        {
            <div class="about-empty">Activities and initiatives will be listed here soon.</div>
        }
    </section>

    <!-- CURRENT LEADERSHIP -->
    <section class="about-section">
        <div class="about-section-header">
            <div>
                <div class="about-section-kicker"><i class="fa-solid fa-user-tie"></i> Executive Team</div>
                <h2 class="about-section-title">Current Leadership</h2>
            </div>
        </div>

        @if (leadership.Any())
        {
            <div class="row g-4" id="leadershipList">
                @for (int i = 0; i < leadership.Count; i++)
                {
                    var leader = leadership[i];
                    <div class="col-lg-3 col-md-4 col-sm-6 leadership-item @(i >= 4 ? "d-none" : "")">
                        <div class="about-item-card">
                            <div class="about-card-img-wrap">
                                @if (leader.ImageData != null && leader.ImageData.Length > 0)
                                {
                                    <img src="data:image/jpeg;base64,@Convert.ToBase64String(leader.ImageData)" class="about-card-img" alt="@leader.Name" />
                                }
                                else
                                {
                                    <div class="about-card-placeholder"><i class="fa-regular fa-user"></i></div>
                                }
                            </div>
                            <div class="about-card-body text-center">
                                <h5 class="about-card-title">@leader.Name</h5>
                                <p class="about-card-role">@leader.Position</p>
                                <a asp-action="LeadershipDetails" asp-route-id="@leader.Id" class="about-card-btn">
                                    <span>View Profile</span>
                                    <i class="fa-solid fa-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (leadership.Count > 4)
            {
                <div class="text-center">
                    <button type="button" class="about-toggle-btn" id="toggleLeadership">
                        <span>Show More</span>
                        <i class="fa-solid fa-chevron-down"></i>
                    </button>
                </div>
            }
        }
        else
        {
            <div class="about-empty">Current leadership members have not been added yet.</div>
        }
    </section>

    <!-- ADVISORS -->
    <section class="about-section">
        <div class="about-section-header">
            <div>
                <div class="about-section-kicker"><i class="fa-solid fa-users"></i> Guidance Panel</div>
                <h2 class="about-section-title">Our Advisors</h2>
            </div>
        </div>

        @if (advisors.Any())
        {
            <div class="row g-4" id="advisorList">
                @for (int i = 0; i < advisors.Count; i++)
                {
                    var a = advisors[i];
                    <div class="col-lg-3 col-md-4 col-sm-6 advisor-item @(i >= 4 ? "d-none" : "")">
                        <div class="about-item-card">
                            <div class="about-card-img-wrap">
                                @if (a.ImageData != null && a.ImageData.Length > 0)
                                {
                                    <img src="data:image/jpeg;base64,@Convert.ToBase64String(a.ImageData)" class="about-card-img" alt="@a.Name" />
                                }
                                else
                                {
                                    <div class="about-card-placeholder"><i class="fa-regular fa-user"></i></div>
                                }
                            </div>
                            <div class="about-card-body">
                                <h5 class="about-card-title">@a.Name</h5>
                                <p class="about-card-role">@a.Role</p>
                                <a asp-action="AdvisorDetails" asp-route-id="@a.Id" class="about-card-btn">
                                    <span>View Profile</span>
                                    <i class="fa-solid fa-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (advisors.Count > 4)
            {
                <div class="text-center">
                    <button type="button" class="about-toggle-btn" id="toggleAdvisors">
                        <span>Show More</span>
                        <i class="fa-solid fa-chevron-down"></i>
                    </button>
                </div>
            }
        }
        else
        {
            <div class="about-empty">Advisor profiles have not been added yet.</div>
        }
    </section>

    <!-- PREVIOUS PRESIDENTS -->
    <section class="about-section">
        <div class="about-section-header">
            <div>
                <div class="about-section-kicker"><i class="fa-solid fa-award"></i> Legacy</div>
                <h2 class="about-section-title">Previous Presidents</h2>
            </div>
        </div>

        @if (previousPresidents.Any())
        {
            <div class="row g-4" id="presidentsList">
                @for (int i = 0; i < previousPresidents.Count; i++)
                {
                    var p = previousPresidents[i];
                    <div class="col-lg-3 col-md-4 col-sm-6 president-item @(i >= 4 ? "d-none" : "")">
                        <div class="about-item-card">
                            <div class="about-card-img-wrap">
                                @if (p.ImageData != null && p.ImageData.Length > 0)
                                {
                                    <img src="data:image/jpeg;base64,@Convert.ToBase64String(p.ImageData)" class="about-card-img" alt="@p.Name" />
                                }
                                else
                                {
                                    <div class="about-card-placeholder"><i class="fa-regular fa-user"></i></div>
                                }
                            </div>
                            <div class="about-card-body">
                                <h5 class="about-card-title">@p.Name</h5>
                                <p class="about-card-role">
                                    <i class="fa-regular fa-calendar me-1"></i>@p.TenureStart.ToString("yyyy") – @p.TenureEnd.ToString("yyyy")
                                </p>
                                <a asp-action="PreviousPresidentDetails" asp-route-id="@p.Id" class="about-card-btn">
                                    <span>View Details</span>
                                    <i class="fa-solid fa-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (previousPresidents.Count > 4)
            {
                <div class="text-center">
                    <button type="button" class="about-toggle-btn" id="togglePresidents">
                        <span>Show More</span>
                        <i class="fa-solid fa-chevron-down"></i>
                    </button>
                </div>
            }
        }
        else
        {
            <div class="about-empty">Previous presidents archive has not been added yet.</div>
        }
    </section>

    <!-- OUR STORY -->
    <section class="about-section">
        <div class="about-section-header">
            <div>
                <div class="about-section-kicker"><i class="fa-solid fa-clock-rotate-left"></i> Milestones</div>
                <h2 class="about-section-title">Our Story</h2>
            </div>
        </div>

        @if (stories.Any())
        {
            <div class="about-card">
                <div id="timelineContainer" class="about-timeline">
                    @for (int i = 0; i < stories.Count; i++)
                    {
                        var story = stories[i];
                        <div class="about-timeline-item story-item @(i >= 4 ? "d-none" : "")">
                            <span class="about-timeline-date">@story.EventDate.ToString("dd MMMM, yyyy")</span>
                            <p class="about-timeline-desc">@story.Description</p>
                        </div>
                    }
                </div>

                @if (stories.Count > 4)
                {
                    <div class="text-center">
                        <button type="button" id="toggleStoryBtn" class="about-toggle-btn">
                            <span>Show More</span>
                            <i class="fa-solid fa-chevron-down"></i>
                        </button>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="about-empty">Organizational milestones and story will be shared here soon.</div>
        }
    </section>

    <!-- CONTACT INFO -->
    <section class="about-section">
        <div class="about-section-header">
            <div>
                <div class="about-section-kicker"><i class="fa-solid fa-address-book"></i> Get In Touch</div>
                <h2 class="about-section-title">Contact Information</h2>
            </div>
        </div>

        @if (Model.ContactInfo != null)
        {
            <div class="about-card">
                <div class="about-contact-grid">
                    @if (!string.IsNullOrWhiteSpace(Model.ContactInfo.Email))
                    {
                        <div class="about-contact-item">
                            <span class="about-contact-icon"><i class="fa-regular fa-envelope"></i></span>
                            <div>
                                <div class="about-contact-label">Email Address</div>
                                <div class="about-contact-value">
                                    <a href="mailto:@Model.ContactInfo.Email">@Model.ContactInfo.Email</a>
                                </div>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.ContactInfo.Phone))
                    {
                        <div class="about-contact-item">
                            <span class="about-contact-icon"><i class="fa-solid fa-phone"></i></span>
                            <div>
                                <div class="about-contact-label">Phone Number</div>
                                <div class="about-contact-value">
                                    <a href="tel:@Model.ContactInfo.Phone">@Model.ContactInfo.Phone</a>
                                </div>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.ContactInfo.Address))
                    {
                        <div class="about-contact-item">
                            <span class="about-contact-icon"><i class="fa-solid fa-location-dot"></i></span>
                            <div>
                                <div class="about-contact-label">Office Address</div>
                                <div class="about-contact-value">@Model.ContactInfo.Address</div>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.ContactInfo.FacebookUrl))
                    {
                        <div class="about-contact-item">
                            <span class="about-contact-icon"><i class="fa-brands fa-facebook-f"></i></span>
                            <div>
                                <div class="about-contact-label">Facebook Page</div>
                                <div class="about-contact-value">
                                    <a href="@Model.ContactInfo.FacebookUrl" target="_blank" rel="noopener noreferrer">@Model.ContactInfo.FacebookUrl</a>
                                </div>
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.ContactInfo.WebsiteUrl))
                    {
                        <div class="about-contact-item">
                            <span class="about-contact-icon"><i class="fa-solid fa-globe"></i></span>
                            <div>
                                <div class="about-contact-label">Website</div>
                                <div class="about-contact-value">
                                    <a href="@Model.ContactInfo.WebsiteUrl" target="_blank" rel="noopener noreferrer">@Model.ContactInfo.WebsiteUrl</a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="about-empty">Contact details are available in the footer below.</div>
        }
    </section>

</div>

@section Scripts {
    <script>
        function setupToggle(sectionClass, buttonId, initialLimit) {
            const items = document.querySelectorAll("." + sectionClass);
            const btn = document.getElementById(buttonId);
            if (!btn || !items.length) return;

            btn.addEventListener("click", function () {
                const hiddenItems = Array.from(items).filter(x => x.classList.contains("d-none"));

                if (hiddenItems.length > 0) {
                    hiddenItems.forEach(x => x.classList.remove("d-none"));
                    btn.innerHTML = '<span>Show Less</span><i class="fa-solid fa-chevron-up"></i>';
                } else {
                    items.forEach((x, i) => {
                        if (i >= initialLimit) x.classList.add("d-none");
                    });
                    btn.innerHTML = '<span>Show More</span><i class="fa-solid fa-chevron-down"></i>';
                }
            });
        }

        setupToggle("mission-item", "toggleMissionBtn", 4);
        setupToggle("whatwedo-item", "toggleWhatWeDo", 4);
        setupToggle("leadership-item", "toggleLeadership", 4);
        setupToggle("advisor-item", "toggleAdvisors", 4);
        setupToggle("president-item", "togglePresidents", 4);
        setupToggle("story-item", "toggleStoryBtn", 4);
    </script>
}
