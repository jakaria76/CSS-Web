@model CSS.Models.PreviousPresident

@{
    ViewData["Title"] = "Previous President Details";
}

<link rel="stylesheet" href="~/css/about.css" asp-append-version="true" />

<section class="about-hero">
    <div class="about-hero-inner">
        <div class="about-breadcrumb">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <span>/</span>
            <a asp-action="Index">About</a>
            <span>/</span>
            <span>Previous President</span>
        </div>
        <h1 class="about-hero-title">Previous President</h1>
    </div>
</section>

<div class="container py-5">
    <div class="about-detail-card">
        <div class="row g-4 align-items-start">
            <div class="col-md-4">
                @if (Model.ImageData != null && Model.ImageData.Length > 0)
                {
                    <img src="data:image/jpeg;base64,@Convert.ToBase64String(Model.ImageData)"
                         class="about-detail-img"
                         alt="@Model.Name" />
                }
                else
                {
                    <div class="about-detail-img d-flex align-items-center justify-content-center bg-light text-muted">
                        <i class="fa-regular fa-user fa-3x"></i>
                    </div>
                }
            </div>

            <div class="col-md-8">
                <h2 class="about-detail-name">@Model.Name</h2>
                <div class="about-detail-role">
                    <i class="fa-regular fa-calendar"></i>
                    <span>Tenure: @Model.TenureStart.ToString("yyyy") – @Model.TenureEnd.ToString("yyyy")</span>
                </div>

                <div class="about-detail-body mb-4">@Model.LegacyNote</div>

                <a asp-action="Index" class="about-back-btn">
                    <i class="fa-solid fa-arrow-left"></i>
                    <span>Back to About</span>
                </a>
            </div>
        </div>
    </div>
</div>
