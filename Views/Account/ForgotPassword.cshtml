@model CSS.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

<section class="auth-page-wrapper">
    <div class="auth-single-card">
        <div class="text-center">
            <div class="auth-icon-badge">
                <i class="fa-solid fa-key"></i>
            </div>
            <h1 class="auth-heading">Forgot Password?</h1>
            <p class="auth-subheading">Enter your email and we will send you a 6-digit verification code.</p>
        </div>

        <form asp-controller="Account" asp-action="ForgotPassword" method="post" novalidate>
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="auth-validation-summary" role="alert"></div>

            <div class="mb-4">
                <label asp-for="Email" class="auth-label"></label>
                <div class="auth-input-group">
                    <i class="fa-regular fa-envelope auth-input-icon"></i>
                    <input asp-for="Email"
                           type="email"
                           autocomplete="email"
                           class="auth-field"
                           placeholder="you@example.com" />
                </div>
                <span asp-validation-for="Email" class="auth-field-error"></span>
            </div>

            <button type="submit" class="auth-submit-btn">
                <i class="fa-regular fa-paper-plane"></i>
                <span>Send Verification OTP</span>
            </button>
        </form>

        <p class="auth-switch-text mb-0">
            Remembered your password?
            <a asp-controller="Account" asp-action="Login" class="auth-link">Back to Sign In</a>
        </p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
