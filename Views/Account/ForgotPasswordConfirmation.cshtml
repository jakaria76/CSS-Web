@{
    ViewData["Title"] = "OTP Sent";
}

<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

<section class="auth-page-wrapper">
    <div class="auth-single-card text-center">
        <div class="auth-icon-badge">
            <i class="fa-solid fa-envelope-circle-check"></i>
        </div>

        <h1 class="auth-heading">Check Your Email</h1>
        <p class="auth-subheading">
            If an account exists for that email, we’ve sent a 6-digit OTP code.
            Please check your Inbox or Spam folder.
        </p>

        <a asp-controller="Account" asp-action="VerifyOtp" class="auth-submit-btn">
            <span>Enter OTP Code</span>
            <i class="fa-solid fa-arrow-right"></i>
        </a>

        <p class="auth-switch-text mb-0">
            Didn't receive the code?
            <a asp-controller="Account" asp-action="ForgotPassword" class="auth-link">Resend OTP</a>
        </p>
    </div>
</section>
