@using System.Text.Json
@model CSS.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
    ViewData["BrandHeadline"] = "Welcome Back to Conscious Student Society";
    ViewData["BrandDescription"] = "Sign in to manage your profile, update your blood donation availability, and join upcoming social initiatives.";
    ViewData["ReturnUrl"] = Model.ReturnUrl ?? "/";
    var authSuccess = TempData["AuthSuccess"] as string;
}

<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

<section class="auth-page-wrapper">
    <div class="auth-split-card">

        <partial name="_AuthBrandPanel" />

        <div class="auth-form-panel">
            <div class="auth-mobile-brand">
                <img src="~/images/csslogo.png" alt="CSS Logo" />
                <span>CONSCIOUS STUDENT SOCIETY</span>
            </div>

            <h1 class="auth-heading">Sign In</h1>
            <p class="auth-subheading">Enter your credentials to access your account</p>

            @if (!string.IsNullOrEmpty(authSuccess))
            {
                <div class="auth-alert-success" role="status">
                    <i class="fa-solid fa-circle-check fs-5"></i>
                    <span>@authSuccess</span>
                </div>
            }

            @if (TempData["AuthError"] is string authError)
            {
                <div class="auth-validation-summary" role="alert">@authError</div>
            }

            <form asp-controller="Account" asp-action="Login" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <div asp-validation-summary="ModelOnly" class="auth-validation-summary" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="auth-label"></label>
                    <div class="auth-input-group">
                        <i class="fa-regular fa-envelope auth-input-icon"></i>
                        <input asp-for="Email"
                               type="email"
                               autocomplete="email"
                               class="auth-field"
                               placeholder="you@example.com" />
                    </div>
                    <span asp-validation-for="Email" class="auth-field-error"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="auth-label"></label>
                    <div class="auth-input-group">
                        <i class="fa-solid fa-lock auth-input-icon"></i>
                        <input asp-for="Password"
                               id="loginPassword"
                               type="password"
                               autocomplete="current-password"
                               class="auth-field has-toggle"
                               placeholder="Enter your password" />
                        <button type="button"
                                class="auth-password-toggle"
                                data-toggle-password="loginPassword"
                                aria-label="Show password">
                            <i class="fa-regular fa-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="auth-field-error"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check m-0">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label small text-secondary"></label>
                    </div>
                    <a asp-controller="Account" asp-action="ForgotPassword" class="auth-link small">
                        Forgot password?
                    </a>
                </div>

                <button type="submit" class="auth-submit-btn">
                    <i class="fa-solid fa-right-to-bracket"></i>
                    <span>Sign In</span>
                </button>
            </form>

            <partial name="_SocialLoginPartial" />

            <p class="auth-switch-text mb-0">
                Don't have an account?
                <a asp-controller="Account" asp-action="Register" class="auth-link">Create an account</a>
            </p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/auth.js" asp-append-version="true"></script>
    @if (!string.IsNullOrEmpty(authSuccess))
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                if (typeof Swal !== "undefined") {
                    Swal.fire({
                        icon: "success",
                        title: "Registration Successful!",
                        text: @Html.Raw(JsonSerializer.Serialize(authSuccess)),
                        confirmButtonColor: "#15803D"
                    });
                }
            });
        </script>
    }
}
