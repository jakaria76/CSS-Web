@model CSS.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}

<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

<section class="auth-page-wrapper">
    <div class="auth-single-card">
        <div class="text-center">
            <div class="auth-icon-badge">
                <i class="fa-solid fa-lock"></i>
            </div>
            <h1 class="auth-heading">Set New Password</h1>
            <p class="auth-subheading">Create a strong password for <strong>@Model.Email</strong></p>
        </div>

        <form asp-controller="Account" asp-action="ResetPassword" method="post" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Email" />

            <div asp-validation-summary="ModelOnly" class="auth-validation-summary" role="alert"></div>

            <div class="mb-3">
                <label asp-for="NewPassword" class="auth-label"></label>
                <div class="auth-input-group">
                    <i class="fa-solid fa-lock auth-input-icon"></i>
                    <input asp-for="NewPassword"
                           id="resetNewPassword"
                           type="password"
                           autocomplete="new-password"
                           class="auth-field has-toggle"
                           placeholder="Minimum 6 characters" />
                    <button type="button"
                            class="auth-password-toggle"
                            data-toggle-password="resetNewPassword"
                            aria-label="Show password">
                        <i class="fa-regular fa-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="NewPassword" class="auth-field-error"></span>
            </div>

            <div class="mb-4">
                <label asp-for="ConfirmPassword" class="auth-label"></label>
                <div class="auth-input-group">
                    <i class="fa-solid fa-shield-halved auth-input-icon"></i>
                    <input asp-for="ConfirmPassword"
                           id="resetConfirmPassword"
                           type="password"
                           autocomplete="new-password"
                           class="auth-field has-toggle"
                           data-match-password="resetNewPassword"
                           data-match-hint="resetMatchHint"
                           placeholder="Re-enter new password" />
                    <button type="button"
                            class="auth-password-toggle"
                            data-toggle-password="resetConfirmPassword"
                            aria-label="Show password">
                        <i class="fa-regular fa-eye"></i>
                    </button>
                </div>
                <div id="resetMatchHint" class="auth-match-hint"></div>
                <span asp-validation-for="ConfirmPassword" class="auth-field-error"></span>
            </div>

            <button type="submit" class="auth-submit-btn">
                <i class="fa-solid fa-check"></i>
                <span>Update Password</span>
            </button>
        </form>

        <p class="auth-switch-text mb-0">
            <a asp-controller="Account" asp-action="Login" class="auth-link">Back to Sign In</a>
        </p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/auth.js" asp-append-version="true"></script>
}
