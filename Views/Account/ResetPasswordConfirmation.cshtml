@{
    ViewData["Title"] = "Password Reset Successful";
}

<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

<section class="auth-page-wrapper">
    <div class="auth-single-card text-center">
        <div class="auth-icon-badge is-success">
            <i class="fa-solid fa-circle-check"></i>
        </div>

        <h1 class="auth-heading">Password Updated</h1>
        <p class="auth-subheading">
            Your password has been reset successfully. You can now sign in with your new credentials.
        </p>

        <a asp-controller="Account" asp-action="Login" class="auth-submit-btn">
            <i class="fa-solid fa-right-to-bracket"></i>
            <span>Go to Sign In</span>
        </a>
    </div>
</section>
