@model CSS.ViewModels.OtpVerifyViewModel
@{
    ViewData["Title"] = "Verify OTP";
}

<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

<section class="auth-page-wrapper">
    <div class="auth-single-card">
        <div class="text-center">
            <div class="auth-icon-badge">
                <i class="fa-solid fa-shield-halved"></i>
            </div>
            <h1 class="auth-heading">Verify OTP</h1>
            <p class="auth-subheading">
                Enter the 6-digit code sent to <strong>@Model.Email</strong>
            </p>
        </div>

        <form asp-controller="Account" asp-action="VerifyOtp" method="post" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Email" />

            <div asp-validation-summary="ModelOnly" class="auth-validation-summary" role="alert"></div>

            <div class="mb-4">
                <label asp-for="OtpCode" class="auth-label text-center"></label>
                <input asp-for="OtpCode"
                       maxlength="6"
                       inputmode="numeric"
                       autocomplete="one-time-code"
                       class="auth-field auth-otp-input"
                       placeholder="••••••" />
                <span asp-validation-for="OtpCode" class="auth-field-error text-center"></span>
            </div>

            <button type="submit" class="auth-submit-btn">
                <i class="fa-solid fa-circle-check"></i>
                <span>Verify &amp; Continue</span>
            </button>
        </form>

        <p class="auth-switch-text mb-0">
            Didn't receive it?
            <a asp-controller="Account" asp-action="ForgotPassword" class="auth-link">Resend OTP</a>
        </p>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/auth.js" asp-append-version="true"></script>
}
