@{
    var returnUrl = ViewData["ReturnUrl"] as string ?? "/";
}

<div class="auth-divider"><span>or continue with</span></div>

<div class="auth-social-grid">
    <a asp-controller="Account" asp-action="GoogleLogin" asp-route-returnUrl="@returnUrl" class="auth-social-btn google">
        <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true">
            <path fill="#EA4335" d="M24 9.5c3.54 0 6.72 1.22 9.21 3.6l6.85-6.85C35.9 2.39 30.47 0 24 0 14.74 0 6.51 5.33 2.56 13.07l7.98 6.19C12.36 13.02 17.74 9.5 24 9.5z" />
            <path fill="#4285F4" d="M46.5 24.5c0-1.72-.15-3.38-.42-5H24v9.5h12.65c-.55 2.94-2.15 5.43-4.57 7.11l7.02 5.46C43.94 37.38 46.5 31.4 46.5 24.5z" />
            <path fill="#FBBC05" d="M10.54 28.26c-.5-1.48-.77-3.06-.77-4.76s.27-3.28.77-4.76l-7.98-6.19C.92 16.64 0 20.24 0 24c0 3.76.92 7.36 2.56 10.65l7.98-6.19z" />
            <path fill="#34A853" d="M24 48c6.48 0 11.94-2.13 15.92-5.79l-7.02-5.46C30.96 38.45 27.7 39.5 24 39.5c-6.26 0-11.64-3.52-14.46-8.76l-7.98 6.19C6.51 42.67 14.74 48 24 48z" />
        </svg>
        <span>Google</span>
    </a>

    <a asp-controller="Account" asp-action="FacebookLogin" asp-route-returnUrl="@returnUrl" class="auth-social-btn facebook">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M22.675 0h-21.35C.597 0 0 .597 0 1.326v21.348C0 23.403.597 24 1.326 24H12.82v-9.294H9.692V11.08h3.128V8.41c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.626h-3.12V24h6.116c.73 0 1.323-.597 1.323-1.326V1.326C24 .597 23.403 0 22.675 0z" />
        </svg>
        <span>Facebook</span>
    </a>
</div>
