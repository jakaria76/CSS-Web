@{
    ViewData["Title"] = "Find Nearest Donors";
    var group = ViewBag.Group as string ?? "A+";
    var allGroups = ViewBag.AllGroups as string[] ?? new[] { "A+", "A-", "B+", "B-", "O+", "O-", "AB+", "AB-" };
}

<link rel="stylesheet" href="~/css/blood.css" asp-append-version="true" />

<!-- HERO -->
<section class="blood-hero">
    <div class="container">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <div class="blood-breadcrumb">
                    <a asp-controller="Home" asp-action="Index">Home</a>
                    <span>/</span>
                    <a asp-action="Index">Blood</a>
                    <span>/</span>
                    <span>Find @group</span>
                </div>
                <h1 class="blood-hero-title">
                    Find Nearest <span class="badge bg-success ms-1 px-3 py-2">@group</span> Donors
                </h1>
                <p class="blood-hero-sub">
                    ম্যাপে ক্লিক করে অথবা আপনার বর্তমান GPS লোকেশন ব্যবহার করে কাছের রক্তদাতা খুঁজুন।
                </p>
            </div>

            <a asp-action="Index" class="btn-css-outline px-3 py-2">
                <i class="fa-solid fa-arrow-left me-1"></i> All Blood Groups
            </a>
        </div>
    </div>
</section>

<div class="container py-4 pb-5">

    <div class="blood-panel-card">
        <!-- Quick Group Switcher -->
        <div class="mb-4 text-center">
            <div class="small fw-semibold text-muted mb-2">Switch Blood Group:</div>
            <div class="blood-group-switcher">
                @foreach (var bg in allGroups)
                {
                    <a asp-action="Find" asp-route-group="@bg"
                       class="blood-switch-pill @(bg == group ? "is-active" : "")">
                        @bg
                    </a>
                }
            </div>
        </div>

        <form id="findDonorForm" asp-action="Find" method="post">
            <input type="hidden" name="group" value="@group" />
            <input type="hidden" id="lat" name="lat" />
            <input type="hidden" id="lng" name="lng" />

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <span id="coordStatus" class="blood-coord-status">
                    <i class="fa-solid fa-location-crosshairs"></i>
                    <span>ম্যাপে ক্লিক করে লোকেশন নির্বাচন করুন</span>
                </span>

                <button type="button" id="btnUseLocation" class="btn-css-outline btn-sm">
                    <i class="fa-solid fa-crosshairs"></i>
                    <span>Use My Current Location</span>
                </button>
            </div>

            <div id="map" class="blood-map-frame"></div>

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mt-4">
                <p class="small text-muted mb-0">
                    <i class="fa-regular fa-lightbulb me-1" style="color:var(--css-primary);"></i>
                    টিপস: ম্যাপের যেকোনো স্থানে ক্লিক করুন অথবা মার্কার টেনে (drag) নিখুঁত অবস্থান ঠিক করুন।
                </p>

                <button type="submit" class="btn-css-primary px-4 py-2">
                    <i class="fa-solid fa-magnifying-glass-location"></i>
                    <span>Search Nearest @group Donors</span>
                </button>
            </div>
        </form>
    </div>

</div>

@section Scripts {
    <script>
        (function () {
            const defaultLat = 23.8103;
            const defaultLng = 90.4125;

            const map = L.map('map').setView([defaultLat, defaultLng], 12);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            let marker = null;
            const latInput = document.getElementById("lat");
            const lngInput = document.getElementById("lng");
            const statusBadge = document.getElementById("coordStatus");

            function updateCoords(lat, lng) {
                latInput.value = lat;
                lngInput.value = lng;
                statusBadge.classList.add("is-ready");
                statusBadge.innerHTML = `<i class="fa-solid fa-circle-check"></i><span>Selected: ${lat.toFixed(5)}, ${lng.toFixed(5)}</span>`;
            }

            function setMarker(lat, lng, doPan = true) {
                if (marker) {
                    marker.setLatLng([lat, lng]);
                } else {
                    marker = L.marker([lat, lng], { draggable: true }).addTo(map);
                    marker.on('dragend', function (e) {
                        const pos = e.target.getLatLng();
                        updateCoords(pos.lat, pos.lng);
                    });
                }

                updateCoords(lat, lng);
                if (doPan) {
                    map.setView([lat, lng], 14);
                }
            }

            map.on('click', function (e) {
                setMarker(e.latlng.lat, e.latlng.lng);
            });

            document.getElementById("btnUseLocation").addEventListener("click", function () {
                const btn = this;
                if (!navigator.geolocation) {
                    Swal.fire({ icon: "warning", title: "Unsupported", text: "Your browser does not support geolocation.", confirmButtonColor: "#15803D" });
                    return;
                }

                btn.disabled = true;
                btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i><span>Locating...</span>';

                navigator.geolocation.getCurrentPosition(function (pos) {
                    setMarker(pos.coords.latitude, pos.coords.longitude);
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fa-solid fa-crosshairs"></i><span>Use My Current Location</span>';
                }, function (err) {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fa-solid fa-crosshairs"></i><span>Use My Current Location</span>';
                    Swal.fire({ icon: "error", title: "Location Error", text: "Unable to access your GPS location: " + err.message, confirmButtonColor: "#15803D" });
                }, { enableHighAccuracy: true, timeout: 10000 });
            });

            document.getElementById("findDonorForm").addEventListener("submit", function (e) {
                if (!latInput.value || !lngInput.value) {
                    e.preventDefault();
                    Swal.fire({
                        icon: "info",
                        title: "লোকেশন নির্বাচন করুন",
                        text: "দয়া করে ম্যাপে ক্লিক করে অথবা 'Use My Current Location' বাটনে ক্লিক করে আপনার অবস্থান নির্বাচন করুন।",
                        confirmButtonColor: "#15803D"
                    });
                }
            });
        })();
    </script>
}
