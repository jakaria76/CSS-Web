@model List<CSS.ViewModels.BloodGroupVM>
@{
    ViewData["Title"] = "Blood Groups";
    int totalDonors = ViewBag.TotalDonors ?? 0;
    int totalAvailable = ViewBag.TotalAvailable ?? 0;
}

<link rel="stylesheet" href="~/css/blood.css" asp-append-version="true" />

<!-- HERO -->
<section class="blood-hero">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <div class="blood-breadcrumb">
                    <a asp-controller="Home" asp-action="Index">Home</a>
                    <span>/</span>
                    <span>Blood Service</span>
                </div>
                <h1 class="blood-hero-title">
                    <i class="fa-solid fa-droplet me-2" style="color:#FA333A;"></i>Blood Donor Network
                </h1>
                <p class="blood-hero-sub">
                    জরুরি প্রয়োজনে রক্তের গ্রুপ নির্বাচন করে আপনার সবচেয়ে কাছের সক্ষম রক্তদাতা খুঁজুন।
                </p>
            </div>

            <div class="col-lg-5">
                <div class="blood-hero-stats">
                    <div class="blood-kpi-box">
                        <div class="blood-kpi-num">@totalDonors</div>
                        <div class="blood-kpi-label">মোট নিবন্ধিত ডোনার</div>
                    </div>
                    <div class="blood-kpi-box">
                        <div class="blood-kpi-num" style="color:#86EFAC;">@totalAvailable</div>
                        <div class="blood-kpi-label">রক্তদানে সক্ষম (Eligible)</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="container blood-grid-wrap pb-5">

    <!-- BLOOD GROUP CARDS -->
    <div class="row g-3 g-md-4">
        @foreach (var bg in Model)
        {
            <div class="col-xl-3 col-lg-4 col-sm-6 col-12">
                <div class="blood-group-card">
                    <div class="blood-card-top">
                        <div class="blood-drop-badge">@bg.BloodGroup</div>

                        @if (bg.Available > 0)
                        {
                            <span class="blood-avail-pill has-donors">
                                <i class="fa-solid fa-circle-check"></i>
                                <span>@bg.Available Ready</span>
                            </span>
                        }
                        else
                        {
                            <span class="blood-avail-pill no-donors">
                                <i class="fa-regular fa-clock"></i>
                                <span>0 Ready</span>
                            </span>
                        }
                    </div>

                    <div class="blood-stats-row">
                        <div class="blood-stat-cell">
                            <div class="blood-stat-val">@bg.Total</div>
                            <div class="blood-stat-lbl">Total</div>
                        </div>
                        <div class="blood-stat-cell">
                            <div class="blood-stat-val text-green">@bg.Available</div>
                            <div class="blood-stat-lbl">Available</div>
                        </div>
                        <div class="blood-stat-cell">
                            <div class="blood-stat-val text-red">@bg.NotAvailable</div>
                            <div class="blood-stat-lbl">Unavailable</div>
                        </div>
                    </div>

                    <a asp-controller="Blood"
                       asp-action="Find"
                       asp-route-group="@bg.BloodGroup"
                       class="blood-find-btn">
                        <i class="fa-solid fa-magnifying-glass-location"></i>
                        <span>Find @bg.BloodGroup Donors</span>
                    </a>
                </div>
            </div>
        }
    </div>

    <!-- DONOR PROFILE CTA -->
    <div class="blood-cta-card mt-4">
        <div class="row align-items-center g-3">
            <div class="col-md-8">
                <h5 class="fw-bold mb-1" style="color:var(--css-ink);">
                    <i class="fa-solid fa-heart-pulse me-2" style="color:var(--css-primary);"></i>রক্তদাতা হিসেবে নিজেকে যুক্ত করতে চান?
                </h5>
                <p class="text-muted small mb-0">
                    আপনার প্রোফাইলে রক্তের গ্রুপ, লোকেশন ও সর্বশেষ রক্তদানের তারিখ আপডেট রাখুন—যাতে জরুরি মুহূর্তে রোগীর স্বজনরা আপনাকে খুঁজে পেতে পারেন।
                </p>
            </div>
            <div class="col-md-4 text-md-end">
                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <a asp-controller="Profile" asp-action="Edit" class="btn-css-primary">
                        <i class="fa-solid fa-user-pen"></i>
                        <span>Update Donor Info</span>
                    </a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Register" class="btn-css-primary">
                        <i class="fa-solid fa-user-plus"></i>
                        <span>Register as Donor</span>
                    </a>
                }
            </div>
        </div>
    </div>

</div>
