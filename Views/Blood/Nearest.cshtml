@using System.Text.Json
@model List<CSS.ViewModels.DonorWithDistance>
@{
    ViewData["Title"] = "Nearest Donors";
    var searchLat = (double?)(ViewBag.UserLatitude) ?? 23.8103;
    var searchLng = (double?)(ViewBag.UserLongitude) ?? 90.4125;
    var group = ViewBag.Group as string ?? "";

    var donorJsonList = Model.Select((d, idx) => new
    {
        index = idx,
        id = d.User.Id,
        name = string.IsNullOrWhiteSpace(d.User.FullName) ? "CSS Donor" : d.User.FullName,
        lat = d.User.Latitude,
        lng = d.User.Longitude,
        distance = Math.Round(d.DistanceKm, 2),
        dms = d.User.LocationDms ?? "",
        district = d.User.District ?? ""
    }).ToList();
}

<link rel="stylesheet" href="~/css/blood.css" asp-append-version="true" />

<!-- HERO -->
<section class="blood-hero">
    <div class="container">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div>
                <div class="blood-breadcrumb">
                    <a asp-controller="Home" asp-action="Index">Home</a>
                    <span>/</span>
                    <a asp-action="Index">Blood</a>
                    <span>/</span>
                    <span>Nearest @group</span>
                </div>
                <h1 class="blood-hero-title">
                    Nearest <span class="badge bg-success ms-1 px-3 py-2">@group</span> Donors
                </h1>
                <p class="blood-hero-sub">
                    আপনার নির্বাচিত অবস্থান থেকে দূরত্ব অনুযায়ী নিকটতম রক্তদাতাদের তালিকা।
                </p>
            </div>

            <div class="d-flex gap-2">
                <a asp-action="Find" asp-route-group="@group" class="btn-css-outline px-3 py-2">
                    <i class="fa-solid fa-location-dot me-1"></i> Change Location
                </a>
                <a asp-action="Index" class="btn-css-primary px-3 py-2">
                    All Groups
                </a>
            </div>
        </div>
    </div>
</section>

<div class="container py-4 pb-5">
    <div class="row g-4">

        <!-- LEFT SIDE: DONOR LIST -->
        <div class="col-lg-6">
            <div class="donor-list-card h-100">
                <div class="donor-list-header">
                    <h6 class="fw-bold mb-0" style="color:var(--css-ink);">
                        <i class="fa-solid fa-users me-2" style="color:var(--css-primary);"></i>Available Donors (@Model.Count)
                    </h6>
                    <span class="small text-muted">Sorted by distance</span>
                </div>

                @if (Model != null && Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table donor-table align-middle">
                            <thead>
                                <tr>
                                    <th style="width:48px;">#</th>
                                    <th>Donor</th>
                                    <th>Distance</th>
                                    <th class="text-end">Profile</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Count; i++)
                                {
                                    var d = Model[i];
                                    var name = string.IsNullOrWhiteSpace(d.User.FullName) ? "CSS Donor" : d.User.FullName;

                                    <tr data-donor-index="@i" title="Click to focus on map">
                                        <td><span class="donor-rank-badge">@(i + 1)</span></td>
                                        <td>
                                            <div class="fw-semibold text-dark">@name</div>
                                            @if (!string.IsNullOrWhiteSpace(d.User.District))
                                            {
                                                <div class="small text-muted">
                                                    <i class="fa-solid fa-location-dot me-1"></i>@d.User.District
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            <span class="distance-pill">
                                                <i class="fa-solid fa-route me-1" style="color:var(--css-primary);"></i>
                                                @Math.Round(d.DistanceKm, 2) km
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <a asp-controller="Profile" asp-action="View" asp-route-id="@d.User.Id"
                                               class="btn-css-outline btn-sm py-1 px-3"
                                               onclick="event.stopPropagation();">
                                                View
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="blood-empty-box">
                        <i class="fa-solid fa-droplet-slash d-block"></i>
                        <h6 class="fw-bold text-dark mb-1">এই মুহূর্তে কোনো সক্ষম @group রক্তদাতা পাওয়া যায়নি</h6>
                        <p class="small mb-3">
                            ডোনারের প্রোফাইলে লোকেশন ও রক্তদানের যোগ্যতা ("Eligible") সেট করা থাকলে এখানে দেখাবে।
                        </p>
                        <a asp-action="Index" class="btn-css-primary btn-sm">
                            <i class="fa-solid fa-arrow-left"></i>
                            <span>অন্য রক্তের গ্রুপ দেখুন</span>
                        </a>
                    </div>
                }
            </div>
        </div>

        <!-- RIGHT SIDE: MAP -->
        <div class="col-lg-6">
            <div class="blood-panel-card p-3 h-100">
                <div class="d-flex justify-content-between align-items-center mb-2 px-1">
                    <span class="small fw-bold text-dark">
                        <i class="fa-solid fa-map-location-dot me-1" style="color:var(--css-primary);"></i>Donor Locations Map
                    </span>
                    <span class="small text-muted">তালিকার যেকোনো ডোনারে ক্লিক করলে ম্যাপে ফোকাস হবে</span>
                </div>
                <div id="mapNearest" class="blood-map-frame"></div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const searchLat = @Html.Raw(JsonSerializer.Serialize(searchLat));
            const searchLng = @Html.Raw(JsonSerializer.Serialize(searchLng));
            const donors = @Html.Raw(JsonSerializer.Serialize(donorJsonList));

            const map = L.map('mapNearest').setView([searchLat, searchLng], 12);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; OpenStreetMap contributors'
            }).addTo(map);

            L.circleMarker([searchLat, searchLng], {
                radius: 9,
                fillColor: "#0F172A",
                color: "#ffffff",
                weight: 3,
                opacity: 1,
                fillOpacity: 1
            }).addTo(map).bindPopup("<b>Your Selected Location</b>").openPopup();

            const bounds = [[searchLat, searchLng]];
            const markerByIndex = {};

            function escapeHtml(text) {
                return String(text || "")
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#039;");
            }

            donors.forEach(function (donor) {
                if (donor.lat == null || donor.lng == null) return;

                const marker = L.marker([donor.lat, donor.lng]).addTo(map);
                const popupHtml = `
                    <div style="min-width:190px;font-family:Segoe UI,sans-serif;">
                        <strong style="color:#0F172A;font-size:14px;">${escapeHtml(donor.name)}</strong><br>
                        <span style="color:#15803D;font-weight:700;font-size:12.5px;">Distance: ${donor.distance} km</span><br>
                        ${donor.district ? `<small style="color:#64748B;">${escapeHtml(donor.district)}</small><br>` : ""}
                        ${donor.dms ? `<small style="color:#64748B;">${escapeHtml(donor.dms)}</small><br>` : ""}
                        <a href="/Profile/View/${encodeURIComponent(donor.id)}" class="btn btn-sm btn-success mt-2 w-100 text-white">View Profile</a>
                    </div>
                `;

                marker.bindPopup(popupHtml);
                markerByIndex[donor.index] = marker;
                bounds.push([donor.lat, donor.lng]);

                L.polyline(
                    [[searchLat, searchLng], [donor.lat, donor.lng]],
                    { color: '#15803D', weight: 1.5, opacity: 0.45, dashArray: '5, 6' }
                ).addTo(map);
            });

            if (bounds.length > 1) {
                map.fitBounds(bounds, { padding: [45, 45] });
            }

            document.querySelectorAll("tr[data-donor-index]").forEach(function (row) {
                row.addEventListener("click", function () {
                    const idx = this.getAttribute("data-donor-index");
                    const marker = markerByIndex[idx];
                    if (marker) {
                        map.setView(marker.getLatLng(), 14);
                        marker.openPopup();
                    }
                });
            });
        })();
    </script>
}
