@model List<CSS.ViewModels.CommitteeMemberVM>
@{
    ViewData["Title"] = "Committee Members";
    string selectedCategory = ViewBag.SelectedCategory as string ?? "";
    int totalCount = ViewBag.TotalCount ?? 0;
    int topCount = ViewBag.TopCount ?? 0;
    int execCount = ViewBag.ExecutiveCount ?? 0;
    int generalCount = ViewBag.GeneralCount ?? 0;
}

<link rel="stylesheet" href="~/css/committee.css" asp-append-version="true" />

<!-- HERO -->
<section class="committee-hero">
    <div class="container committee-hero-inner">
        <div class="row align-items-center g-4">
            <div class="col-lg-8">
                <div class="committee-breadcrumb">
                    <a asp-controller="Home" asp-action="Index">Home</a>
                    <span>/</span>
                    <span>Committee</span>
                </div>
                <h1 class="committee-hero-title">Executive Committee Directory</h1>
                <p class="committee-hero-sub">
                    সচেতন ছাত্র সমাজ (Conscious Student Society)-এর দায়িত্বশীল নেতৃত্ব ও কার্যনির্বাহী সদস্যবৃন্দ।
                </p>
            </div>
            <div class="col-lg-4 text-lg-end">
                <div class="committee-summary-pill">
                    <i class="fa-solid fa-users-gear"></i>
                    <div class="text-start">
                        <div class="committee-summary-num">@totalCount</div>
                        <div class="committee-summary-label">মোট কমিটি সদস্য</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="container pb-5">

    <!-- SEARCH & FILTER TOOLBAR -->
    <div class="committee-toolbar mb-4">
        <div class="committee-search-wrap">
            <i class="fa-solid fa-magnifying-glass committee-search-icon"></i>
            <input id="searchInput"
                   type="search"
                   value="@ViewBag.Search"
                   placeholder="নাম বা পদবি দিয়ে খুঁজুন..."
                   class="committee-search-input"
                   aria-label="Search committee members" />
        </div>

        <div class="committee-filters">
            <a asp-action="Index" asp-route-category=""
               class="committee-filter-pill @(string.IsNullOrEmpty(selectedCategory) ? "is-active" : "")">
                <span>All</span>
                <span class="committee-count-tag">@totalCount</span>
            </a>
            <a asp-action="Index" asp-route-category="Top"
               class="committee-filter-pill @(selectedCategory == "Top" ? "is-active" : "")">
                <span>Top-Level</span>
                <span class="committee-count-tag">@topCount</span>
            </a>
            <a asp-action="Index" asp-route-category="Executive"
               class="committee-filter-pill @(selectedCategory == "Executive" ? "is-active" : "")">
                <span>Executive</span>
                <span class="committee-count-tag">@execCount</span>
            </a>
            <a asp-action="Index" asp-route-category="Members"
               class="committee-filter-pill @(selectedCategory == "Members" ? "is-active" : "")">
                <span>Members</span>
                <span class="committee-count-tag">@generalCount</span>
            </a>
        </div>
    </div>

    <!-- MEMBERS GRID -->
    @if (Model != null && Model.Any())
    {
        <div class="row g-4" id="committeeGrid">
            @foreach (var m in Model)
            {
                var initial = !string.IsNullOrWhiteSpace(m.FullName)
                    ? m.FullName.Substring(0, 1).ToUpperInvariant()
                    : "C";

                <div class="col-12 col-sm-6 col-md-4 col-lg-3 committee-item">
                    <div class="committee-card @(m.IsTopLevel ? "is-top-leader" : "")">

                        <div class="committee-avatar-wrap">
                            @if (!string.IsNullOrEmpty(m.ProfileImageSrc))
                            {
                                <img src="@m.ProfileImageSrc"
                                     class="committee-avatar"
                                     alt="@m.FullName"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                <div class="committee-avatar-fallback" style="display:none;">@initial</div>
                            }
                            else
                            {
                                <div class="committee-avatar-fallback">@initial</div>
                            }
                        </div>

                        <h5 class="committee-name">@m.FullName</h5>

                        @if (!string.IsNullOrWhiteSpace(m.FullNameBn))
                        {
                            <p class="committee-name-bn">@m.FullNameBn</p>
                        }

                        <div class="committee-role-badge">@m.CommitteePosition</div>

                        @if (!string.IsNullOrWhiteSpace(m.District) || !string.IsNullOrWhiteSpace(m.BloodGroup))
                        {
                            <div class="committee-meta">
                                @if (!string.IsNullOrWhiteSpace(m.District))
                                {
                                    <span class="committee-meta-tag">
                                        <i class="fa-solid fa-location-dot"></i> @m.District
                                    </span>
                                }
                                @if (!string.IsNullOrWhiteSpace(m.BloodGroup))
                                {
                                    <span class="committee-meta-tag text-danger fw-semibold">
                                        <i class="fa-solid fa-droplet"></i> @m.BloodGroup
                                    </span>
                                }
                            </div>
                        }

                        <a asp-controller="Profile"
                           asp-action="View"
                           asp-route-id="@m.Id"
                           class="committee-profile-btn">
                            <span>View Profile</span>
                            <i class="fa-solid fa-arrow-right"></i>
                        </a>

                    </div>
                </div>
            }
        </div>

        <div id="noSearchResults" class="committee-empty mt-3 d-none">
            <i class="fa-solid fa-user-slash d-block"></i>
            <h6 class="fw-bold text-dark mb-1">কোনো সদস্য পাওয়া যায়নি</h6>
            <p class="small mb-0">অন্য নাম বা পদবি লিখে আবার চেষ্টা করুন।</p>
        </div>
    }
    else
    {
        <div class="committee-empty">
            <i class="fa-solid fa-users-slash d-block"></i>
            <h6 class="fw-bold text-dark mb-1">এই ক্যাটাগরিতে এখনো কোনো কমিটি সদস্য যুক্ত করা হয়নি</h6>
            <p class="small mb-0">অ্যাডমিন প্যানেল থেকে সদস্যের Member Type হিসেবে <strong>Committee</strong> সেট করলে এখানে দেখা যাবে।</p>
        </div>
    }

</div>

@section Scripts {
    <script>
        (function () {
            const searchInput = document.getElementById("searchInput");
            const cards = document.querySelectorAll(".committee-item");
            const noResults = document.getElementById("noSearchResults");
            if (!searchInput || !cards.length) return;

            function filterCards() {
                const query = searchInput.value.trim().toLowerCase();
                let visibleCount = 0;

                cards.forEach(card => {
                    const text = card.innerText.toLowerCase();
                    const match = text.includes(query);
                    card.style.display = match ? "" : "none";
                    if (match) visibleCount++;
                });

                if (noResults) {
                    noResults.classList.toggle("d-none", visibleCount > 0);
                }
            }

            searchInput.addEventListener("input", filterCards);
        })();
    </script>
}
