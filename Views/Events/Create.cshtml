@using System.Globalization
@model CSS.ViewModels.EventCreateVM
@{
    ViewData["Title"] = "Create Event";
}

<link rel="stylesheet" href="~/css/events.css" asp-append-version="true" />

<section class="events-hero">
    <div class="container position-relative" style="z-index:2;">
        <div class="events-breadcrumb">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <span>/</span>
            <a asp-action="Index">Events</a>
            <span>/</span>
            <span>Create</span>
        </div>
        <h1 class="events-hero-title">Create New Event</h1>
        <p class="events-hero-sub">Publish a new event or initiative for Conscious Student Society members.</p>
    </div>
</section>

<div class="container py-5">
    <div class="event-form-card">
        <form method="post" enctype="multipart/form-data" asp-action="Create">
            @Html.AntiForgeryToken()

            <div class="row g-3 mb-3">
                <div class="col-md-8">
                    <label class="reg-label">Event Title <span class="text-danger">*</span></label>
                    <input class="form-control reg-input" name="Title" required value="@Model.Title" placeholder="Enter event title" />
                </div>
                <div class="col-md-4">
                    <label class="reg-label">Price (BDT)</label>
                    <input type="number" step="0.01" class="form-control reg-input" name="Price"
                           value="@(Model.Price?.ToString(CultureInfo.InvariantCulture) ?? "0")"
                           placeholder="0 = Free Event" />
                </div>
            </div>

            <div class="mb-3">
                <label class="reg-label">Tags / Categories (comma separated)</label>
                <input class="form-control reg-input" name="Tag" value="@Model.Tag" placeholder="Blood Camp, Seminar, Welfare" />
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="reg-label">Start Date &amp; Time</label>
                    <input type="datetime-local" class="form-control reg-input" name="StartDateTime"
                           value="@(Model.StartDateTime?.ToString("yyyy-MM-ddTHH:mm") ?? "")" />
                </div>
                <div class="col-md-6">
                    <label class="reg-label">End Date &amp; Time</label>
                    <input type="datetime-local" class="form-control reg-input" name="EndDateTime"
                           value="@(Model.EndDateTime?.ToString("yyyy-MM-ddTHH:mm") ?? "")" />
                </div>
            </div>

            <div class="mb-3">
                <label class="reg-label">Venue <span class="text-danger">*</span></label>
                <input class="form-control reg-input" name="Venue" required value="@Model.Venue" placeholder="Event venue / address" />
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="reg-label">Latitude</label>
                    <input class="form-control reg-input" id="Latitude" name="Latitude"
                           value="@(Model.Latitude?.ToString(CultureInfo.InvariantCulture) ?? "")" />
                </div>
                <div class="col-md-6">
                    <label class="reg-label">Longitude</label>
                    <input class="form-control reg-input" id="Longitude" name="Longitude"
                           value="@(Model.Longitude?.ToString(CultureInfo.InvariantCulture) ?? "")" />
                </div>
            </div>

            <div id="eventMap" style="height:320px;border-radius:14px;border:1px solid var(--css-border);" class="mb-2"></div>

            <button type="button" id="btnUseMyLocation" class="btn-css-outline btn-sm mb-4">
                <i class="fa-solid fa-crosshairs"></i>
                <span>Use My Location</span>
            </button>

            <div class="mb-3">
                <label class="reg-label">Short Description</label>
                <input class="form-control reg-input" name="ShortDescription" value="@Model.ShortDescription" placeholder="Brief summary shown on cards" />
            </div>

            <div class="mb-3">
                <label class="reg-label">Full Description (HTML allowed)</label>
                <textarea class="form-control reg-input" rows="5" name="FullDescription">@Model.FullDescription</textarea>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="reg-label">Banner Image</label>
                    <input type="file" class="form-control reg-input" name="BannerImage" accept="image/*" />
                </div>
                <div class="col-md-6">
                    <label class="reg-label">Gallery Images</label>
                    <input type="file" class="form-control reg-input" name="GalleryImages" multiple accept="image/*" />
                </div>
            </div>

            <div class="d-flex flex-wrap gap-4 my-3">
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="chkPublished" name="IsPublished" value="true" checked />
                    <label class="form-check-label fw-semibold" for="chkPublished">Publish Event</label>
                </div>

                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="chkFeatured" name="IsFeatured" value="true" />
                    <label class="form-check-label fw-semibold" for="chkFeatured">Mark as Featured</label>
                </div>
            </div>

            <div class="d-flex gap-2 pt-2">
                <button class="btn-css-primary px-4" type="submit">
                    <i class="fa-solid fa-floppy-disk"></i>
                    <span>Save Event</span>
                </button>
                <a asp-action="Index" class="btn btn-light border rounded-3 px-4 fw-semibold">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        var lat = parseFloat("@(Model.Latitude?.ToString(CultureInfo.InvariantCulture) ?? "23.8103")");
        var lng = parseFloat("@(Model.Longitude?.ToString(CultureInfo.InvariantCulture) ?? "90.4125")");

        var map = L.map('eventMap').setView([lat, lng], 15);
        L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", { maxZoom: 19 }).addTo(map);

        var marker = L.marker([lat, lng], { draggable: true }).addTo(map);

        marker.on("dragend", function (e) {
            var pos = e.target.getLatLng();
            document.getElementById("Latitude").value = pos.lat;
            document.getElementById("Longitude").value = pos.lng;
        });

        map.on("click", function (e) {
            marker.setLatLng(e.latlng);
            document.getElementById("Latitude").value = e.latlng.lat;
            document.getElementById("Longitude").value = e.latlng.lng;
        });

        document.getElementById("btnUseMyLocation").addEventListener("click", function () {
            if (!navigator.geolocation) return;
            navigator.geolocation.getCurrentPosition(function (pos) {
                var la = pos.coords.latitude;
                var lo = pos.coords.longitude;
                marker.setLatLng([la, lo]);
                map.setView([la, lo], 17);
                document.getElementById("Latitude").value = la;
                document.getElementById("Longitude").value = lo;
            });
        });
    </script>
}
