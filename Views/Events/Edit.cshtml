@using System.Globalization
@model CSS.ViewModels.EventCreateVM
@{
    ViewData["Title"] = "Edit Event";
}

<link rel="stylesheet" href="~/css/events.css" asp-append-version="true" />

<section class="events-hero">
    <div class="container position-relative" style="z-index:2;">
        <div class="events-breadcrumb">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <span>/</span>
            <a asp-action="Index">Events</a>
            <span>/</span>
            <span>Edit</span>
        </div>
        <h1 class="events-hero-title">Edit Event</h1>
        <p class="events-hero-sub">Update details, schedule, location, or media for @Model.Title.</p>
    </div>
</section>

<div class="container py-5">
    <div class="event-form-card">
        <form method="post" enctype="multipart/form-data" asp-action="Edit">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Id" value="@Model.Id" />

            <div class="row g-3 mb-3">
                <div class="col-md-8">
                    <label class="reg-label">Event Title <span class="text-danger">*</span></label>
                    <input class="form-control reg-input" name="Title" required value="@Model.Title" />
                </div>
                <div class="col-md-4">
                    <label class="reg-label">Price (BDT)</label>
                    <input type="number" step="0.01" class="form-control reg-input" name="Price"
                           placeholder="e.g. 200"
                           value="@(Model.Price?.ToString(CultureInfo.InvariantCulture) ?? "0")" />
                </div>
            </div>

            <div class="mb-3">
                <label class="reg-label">Tags / Categories (comma separated)</label>
                <input class="form-control reg-input" name="Tag" value="@Model.Tag" placeholder="Science, Workshop, Seminar" />
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="reg-label">Start Date &amp; Time</label>
                    <input type="datetime-local" class="form-control reg-input" name="StartDateTime"
                           value="@(Model.StartDateTime?.ToString("yyyy-MM-ddTHH:mm") ?? "")" />
                </div>
                <div class="col-md-6">
                    <label class="reg-label">End Date &amp; Time</label>
                    <input type="datetime-local" class="form-control reg-input" name="EndDateTime"
                           value="@(Model.EndDateTime?.ToString("yyyy-MM-ddTHH:mm") ?? "")" />
                </div>
            </div>

            <div class="mb-3">
                <label class="reg-label">Venue</label>
                <input class="form-control reg-input" name="Venue" value="@Model.Venue" />
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="reg-label">Latitude</label>
                    <input class="form-control reg-input" id="Latitude" name="Latitude"
                           value="@(Model.Latitude?.ToString(CultureInfo.InvariantCulture) ?? "")" />
                </div>
                <div class="col-md-6">
                    <label class="reg-label">Longitude</label>
                    <input class="form-control reg-input" id="Longitude" name="Longitude"
                           value="@(Model.Longitude?.ToString(CultureInfo.InvariantCulture) ?? "")" />
                </div>
            </div>

            <iframe id="googleMap" class="w-100 mb-2"
                    style="height:320px;border:1px solid var(--css-border);border-radius:14px;"
                    loading="lazy" allowfullscreen></iframe>

            <button type="button" class="btn-css-outline btn-sm mb-4" id="btnUseMyLocation">
                <i class="fa-solid fa-crosshairs"></i>
                <span>Use My Location</span>
            </button>

            <div class="mb-3">
                <label class="reg-label">Short Description</label>
                <input class="form-control reg-input" name="ShortDescription" value="@Model.ShortDescription" />
            </div>

            <div class="mb-3">
                <label class="reg-label">Full Description (HTML allowed)</label>
                <textarea class="form-control reg-input" rows="5" name="FullDescription">@Model.FullDescription</textarea>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="reg-label">Banner Image (optional)</label>
                    <input type="file" class="form-control reg-input" name="BannerImage" accept="image/*" />
                </div>
                <div class="col-md-6">
                    <label class="reg-label">Gallery Images (optional)</label>
                    <input type="file" class="form-control reg-input" name="GalleryImages" multiple accept="image/*" />
                </div>
            </div>

            <div class="d-flex flex-wrap gap-4 my-3">
                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="chkEditPub" name="IsPublished" value="true" @(Model.IsPublished ? "checked" : "") />
                    <label class="form-check-label fw-semibold" for="chkEditPub">Publish</label>
                </div>

                <div class="form-check">
                    <input type="checkbox" class="form-check-input" id="chkEditFeat" name="IsFeatured" value="true" @(Model.IsFeatured ? "checked" : "") />
                    <label class="form-check-label fw-semibold" for="chkEditFeat">Featured</label>
                </div>
            </div>

            <div class="d-flex gap-2 pt-2">
                <button class="btn-css-primary px-4" type="submit">
                    <i class="fa-solid fa-floppy-disk"></i>
                    <span>Save Changes</span>
                </button>
                <a asp-action="Index" class="btn btn-light border rounded-3 px-4 fw-semibold">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        var defaultLat = @(Model.Latitude?.ToString(CultureInfo.InvariantCulture) ?? "23.8103");
        var defaultLng = @(Model.Longitude?.ToString(CultureInfo.InvariantCulture) ?? "90.4125");

        function setMap(lat, lng) {
            document.getElementById("googleMap").src =
                `https://www.google.com/maps?q=${lat},${lng}&hl=en&z=18&t=k&output=embed`;
            document.getElementById("Latitude").value = lat;
            document.getElementById("Longitude").value = lng;
        }

        window.onload = function () { setMap(defaultLat, defaultLng); };

        document.getElementById("btnUseMyLocation").addEventListener("click", function () {
            navigator.geolocation.getCurrentPosition(
                function (pos) { setMap(pos.coords.latitude, pos.coords.longitude); },
                function () { alert("Unable to detect location"); },
                { enableHighAccuracy: true }
            );
        });
    </script>
}
