@model List<CSS.Models.GalleryImage>
@{
    ViewData["Title"] = "Gallery";
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
    var selectedCategory = ViewBag.SelectedCategory as string;
    var startDate = ViewBag.StartDate as string;
    var endDate = ViewBag.EndDate as string;
    bool hasFilter = !string.IsNullOrEmpty(selectedCategory) || !string.IsNullOrEmpty(startDate) || !string.IsNullOrEmpty(endDate);
}

<link rel="stylesheet" href="~/css/gallery.css" asp-append-version="true" />

<!-- HERO -->
<section class="gallery-hero">
    <div class="container position-relative" style="z-index:2;">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <div class="gallery-breadcrumb">
                    <a asp-controller="Home" asp-action="Index">Home</a>
                    <span>/</span>
                    <span>Gallery</span>
                </div>
                <h1 class="gallery-hero-title">Photo Gallery Showcase</h1>
                <p class="gallery-hero-sub">
                    সচেতন ছাত্র সমাজের সামাজিক কার্যক্রম, ইভেন্ট, সেমিনার এবং মানবিক উদ্যোগগুলোর স্মরণীয় মুহূর্ত।
                </p>
            </div>

            <div class="col-lg-5">
                <div class="d-flex flex-wrap gap-3 justify-content-lg-end align-items-center">
                    <div class="gallery-count-pill">
                        <i class="fa-regular fa-images"></i>
                        <div>
                            <div class="fw-bold fs-5 lh-1">@Model.Count</div>
                            <div class="small" style="color:var(--muted-foreground);">Total Photos</div>
                        </div>
                    </div>

                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Upload" class="btn-css-primary py-2 px-3">
                            <i class="fa-solid fa-cloud-arrow-up"></i>
                            <span>Upload Photo</span>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<div class="container pb-5">

    <!-- FILTER TOOLBAR -->
    <div class="gallery-toolbar mb-4">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-lg-3 col-md-6">
                <label class="gallery-filter-label">Category</label>
                <select name="category" class="form-select gallery-input">
                    <option value="">All Categories</option>
                    @foreach (var c in categories)
                    {
                        <option value="@c" selected="@(selectedCategory == c)">@c</option>
                    }
                </select>
            </div>

            <div class="col-lg-3 col-md-6">
                <label class="gallery-filter-label">From Date</label>
                <input type="date" name="startDate" value="@startDate" class="form-control gallery-input" />
            </div>

            <div class="col-lg-3 col-md-6">
                <label class="gallery-filter-label">To Date</label>
                <input type="date" name="endDate" value="@endDate" class="form-control gallery-input" />
            </div>

            <div class="col-lg-3 col-md-6 d-flex gap-2">
                <button type="submit" class="btn-css-primary flex-grow-1" style="height:42px;">
                    <i class="fa-solid fa-filter"></i>
                    <span>Filter</span>
                </button>
                @if (hasFilter)
                {
                    <a asp-action="Index" class="btn btn-light border rounded-3 d-inline-flex align-items-center justify-content-center px-3"
                       style="height:42px;" title="Reset Filters">
                        <i class="fa-solid fa-rotate-left"></i>
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- IMAGE GRID -->
    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @for (int i = 0; i < Model.Count; i++)
            {
                var img = Model[i];
                if (img.ImageData == null || img.ImageData.Length == 0) { continue; }
                var contentType = string.IsNullOrWhiteSpace(img.ContentType) ? "image/jpeg" : img.ContentType;
                var imageSrc = $"data:{contentType};base64,{Convert.ToBase64String(img.ImageData)}";
                var dateText = img.UploadDate.ToString("dd MMM yyyy");

                <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                    <div class="gallery-card"
                         data-gallery-item="true"
                         data-src="@imageSrc"
                         data-cat="@img.Category"
                         data-date="@dateText">

                        <div class="gallery-thumb-wrap">
                            <img src="@imageSrc" class="gallery-img" alt="@img.Category photo" loading="lazy" />
                            <div class="gallery-zoom-overlay">
                                <i class="fa-solid fa-magnifying-glass-plus"></i>
                            </div>
                        </div>

                        <div class="gallery-card-footer">
                            <span class="gallery-cat-badge" title="@img.Category">@img.Category</span>

                            <div class="d-flex align-items-center gap-2">
                                <span class="gallery-date-text">@dateText</span>
                                @if (User.IsInRole("Admin"))
                                {
                                    <button type="button"
                                            class="btn btn-outline-danger btn-sm px-2 py-1 rounded-3 delete-btn"
                                            data-id="@img.Id"
                                            title="Delete photo"
                                            onclick="event.stopPropagation();">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                }
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="gallery-empty">
            <i class="fa-regular fa-images d-block"></i>
            <h6 class="fw-bold text-dark mb-1">কোনো ছবি পাওয়া যায়নি</h6>
            <p class="small mb-3">
                @(hasFilter ? "আপনার নির্বাচিত ফিল্টারে কোনো ছবি নেই। ফিল্টার রিসেট করে আবার দেখুন।" : "গ্যালারিতে এখনো কোনো ছবি আপলোড করা হয়নি।")
            </p>
            @if (hasFilter)
            {
                <a asp-action="Index" class="btn-css-outline btn-sm">
                    <i class="fa-solid fa-rotate-left"></i>
                    <span>Reset Filter</span>
                </a>
            }
            else if (User.IsInRole("Admin"))
            {
                <a asp-action="Upload" class="btn-css-primary btn-sm">
                    <i class="fa-solid fa-cloud-arrow-up"></i>
                    <span>Upload First Photo</span>
                </a>
            }
        </div>
    }

</div>

<!-- LIGHTBOX -->
<div class="gallery-lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Image Viewer">
    <button type="button" class="lightbox-close-btn" id="lightboxClose" aria-label="Close">
        <i class="fa-solid fa-xmark"></i>
    </button>
    <button type="button" class="lightbox-nav-btn prev" id="lightboxPrev" aria-label="Previous image">
        <i class="fa-solid fa-chevron-left"></i>
    </button>
    <div class="lightbox-stage" onclick="event.stopPropagation();">
        <img id="lightboxImg" src="" alt="Gallery preview" />
        <div class="lightbox-caption">
            <span id="lightboxCat" class="badge bg-danger px-3 py-1 rounded-pill"></span>
            <span id="lightboxDate"></span>
            <span id="lightboxCounter" class="text-secondary"></span>
        </div>
    </div>
    <button type="button" class="lightbox-nav-btn next" id="lightboxNext" aria-label="Next image">
        <i class="fa-solid fa-chevron-right"></i>
    </button>
</div>

@section Scripts {
    <script>
        (function () {
            const items = Array.from(document.querySelectorAll("[data-gallery-item='true']"));
            const lightbox = document.getElementById("lightbox");
            const lbImg = document.getElementById("lightboxImg");
            const lbCat = document.getElementById("lightboxCat");
            const lbDate = document.getElementById("lightboxDate");
            const lbCounter = document.getElementById("lightboxCounter");
            let currentIndex = 0;

            function showIndex(idx) {
                if (!items.length) return;
                currentIndex = (idx + items.length) % items.length;
                const item = items[currentIndex];
                lbImg.src = item.getAttribute("data-src");
                lbCat.textContent = item.getAttribute("data-cat") || "";
                lbDate.textContent = item.getAttribute("data-date") || "";
                lbCounter.textContent = `(${currentIndex + 1} / ${items.length})`;
                lightbox.classList.add("is-open");
            }

            function closeBox() {
                lightbox.classList.remove("is-open");
            }

            items.forEach((el, i) => {
                el.addEventListener("click", () => showIndex(i));
            });

            document.getElementById("lightboxClose").addEventListener("click", closeBox);
            document.getElementById("lightboxPrev").addEventListener("click", (e) => {
                e.stopPropagation();
                showIndex(currentIndex - 1);
            });
            document.getElementById("lightboxNext").addEventListener("click", (e) => {
                e.stopPropagation();
                showIndex(currentIndex + 1);
            });
            lightbox.addEventListener("click", closeBox);

            document.addEventListener("keydown", function (e) {
                if (!lightbox.classList.contains("is-open")) return;
                if (e.key === "Escape") closeBox();
                else if (e.key === "ArrowLeft") showIndex(currentIndex - 1);
                else if (e.key === "ArrowRight") showIndex(currentIndex + 1);
            });

            // SweetAlert Delete Confirmation
            document.querySelectorAll(".delete-btn").forEach(btn => {
                btn.addEventListener("click", function () {
                    const id = this.getAttribute("data-id");
                    Swal.fire({
                        title: "Are you sure?",
                        text: "Once deleted, you won't be able to recover this photo!",
                        icon: "warning",
                        showCancelButton: true,
                        confirmButtonColor: "#D9232B",
                        cancelButtonColor: "#475569",
                        confirmButtonText: "Yes, delete it!"
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.href = `/Gallery/Delete/${id}`;
                        }
                    });
                });
            });
        })();
    </script>
}
