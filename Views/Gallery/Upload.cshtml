@{
    ViewData["Title"] = "Upload Gallery Photo";
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
    var defaultCats = new[] { "Event", "Blood Camp", "Seminar", "Meeting", "Welfare", "Class Photo" };
    var allCategories = defaultCats.Concat(categories).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
}

<link rel="stylesheet" href="~/css/gallery.css" asp-append-version="true" />

<!-- HERO -->
<section class="gallery-hero">
    <div class="container position-relative" style="z-index:2;">
        <div class="gallery-breadcrumb">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <span>/</span>
            <a asp-action="Index">Gallery</a>
            <span>/</span>
            <span>Upload</span>
        </div>
        <h1 class="gallery-hero-title">Upload Gallery Photo</h1>
        <p class="gallery-hero-sub">Add a new photo to the Conscious Student Society gallery showcase.</p>
    </div>
</section>

<div class="container py-5">
    <div class="gallery-upload-card">

        @if (TempData["error"] is string err)
        {
            <div class="alert alert-danger rounded-3 small fw-semibold mb-3">
                <i class="fa-solid fa-circle-exclamation me-1"></i> @err
            </div>
        }

        <form method="post" enctype="multipart/form-data" asp-action="Upload">
            <img id="preview" class="upload-preview-img" alt="Selected preview" />

            <div class="mb-3">
                <label class="gallery-filter-label">Category <span class="text-danger">*</span></label>
                <input list="categoryOptions"
                       name="category"
                       class="form-control gallery-input"
                       placeholder="Select or type category (e.g. Blood Camp)"
                       required />
                <datalist id="categoryOptions">
                    @foreach (var c in allCategories)
                    {
                        <option value="@c"></option>
                    }
                </datalist>
            </div>

            <div class="mb-3">
                <label class="gallery-filter-label">Upload Date <span class="text-danger">*</span></label>
                <input type="date"
                       name="uploadDate"
                       value="@DateTime.Today.ToString("yyyy-MM-dd")"
                       class="form-control gallery-input"
                       required />
            </div>

            <div class="mb-4">
                <label class="gallery-filter-label">Select Image <span class="text-danger">*</span></label>
                <label class="upload-dropzone w-100" for="galleryFileInput">
                    <i class="fa-solid fa-cloud-arrow-up fs-2 mb-2 d-block" style="color:var(--css-primary);"></i>
                    <span class="fw-semibold text-dark d-block" id="fileLabelText">Click to choose an image file</span>
                    <span class="small text-muted">PNG, JPG, JPEG supported</span>
                    <input type="file"
                           id="galleryFileInput"
                           name="image"
                           class="d-none"
                           accept="image/*"
                           required />
                </label>
            </div>

            <div class="d-flex flex-column gap-2">
                <button type="submit" class="btn-css-primary py-2">
                    <i class="fa-solid fa-upload"></i>
                    <span>Upload Photo</span>
                </button>
                <a asp-action="Index" class="btn btn-light border rounded-3 py-2 fw-semibold">
                    <i class="fa-solid fa-arrow-left me-1"></i> Back to Gallery
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("galleryFileInput").addEventListener("change", function (e) {
            const file = e.target.files[0];
            if (!file) return;

            document.getElementById("fileLabelText").textContent = file.name;
            const preview = document.getElementById("preview");
            preview.src = URL.createObjectURL(file);
            preview.style.display = "block";
        });
    </script>
}
