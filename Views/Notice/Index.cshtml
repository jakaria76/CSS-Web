@model IEnumerable<CSS.Models.Notice>
@{
    ViewData["Title"] = "Notices";
    var notices = Model?.ToList() ?? new List<CSS.Models.Notice>();
}

<link rel="stylesheet" href="~/css/notice.css" asp-append-version="true" />

<!-- HERO -->
<section class="notice-hero">
    <div class="container position-relative" style="z-index:2;">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <div class="notice-breadcrumb">
                    <a asp-controller="Home" asp-action="Index">Home</a>
                    <span>/</span>
                    <span>Notices</span>
                </div>
                <h1 class="notice-hero-title">Official Notice Board</h1>
                <p class="notice-hero-sub">
                    সচেতন ছাত্র সমাজ (CSS)-এর সর্বশেষ প্রকাশিত সকল অফিসিয়াল বিজ্ঞপ্তি ও ঘোষণা।
                </p>
            </div>

            <div class="col-lg-5">
                <div class="d-flex flex-wrap gap-3 justify-content-lg-end align-items-center">
                    <div class="notice-kpi-pill">
                        <i class="fa-solid fa-bullhorn"></i>
                        <div>
                            <div class="fw-bold fs-5 lh-1">@notices.Count</div>
                            <div class="small" style="color:var(--muted-foreground);">Published Notices</div>
                        </div>
                    </div>

                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="NoticeManagement" asp-action="Index" class="btn-css-primary py-2 px-3">
                            <i class="fa-solid fa-sliders"></i>
                            <span>Manage Notices</span>
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<div class="container pb-5">

    <!-- SEARCH TOOLBAR -->
    <div class="notice-toolbar mb-4">
        <div class="notice-search-wrap">
            <i class="fa-solid fa-magnifying-glass notice-search-icon"></i>
            <input id="noticeSearchInput"
                   type="search"
                   placeholder="শিরোনাম বা তারিখ দিয়ে বিজ্ঞপ্তি খুঁজুন..."
                   class="notice-search-input"
                   aria-label="Search notices" />
        </div>

        <div class="small fw-semibold text-muted" id="noticeResultCount">
            Showing @notices.Count notice(s)
        </div>
    </div>

    <!-- NOTICE TABLE CARD -->
    <div class="notice-board-card">
        <div class="notice-board-topbar">
            <span><i class="fa-regular fa-clipboard me-2"></i>বিজ্ঞপ্তিসমূহের তালিকা</span>
            <span class="badge bg-white text-dark rounded-pill px-3 py-1" style="font-size:12px;">PDF Archive</span>
        </div>

        @if (notices.Any())
        {
            <div class="table-responsive">
                <table class="table notice-board-table align-middle" id="noticeTable">
                    <thead>
                        <tr>
                            <th style="width:70px;">ক্রমিক</th>
                            <th>বিজ্ঞপ্তির শিরোনাম</th>
                            <th style="width:170px;">প্রকাশের তারিখ</th>
                            <th style="width:130px;" class="text-end">ফাইল</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int i = 1;
                            foreach (var n in notices)
                            {
                                <tr class="notice-row">
                                    <td><span class="notice-sl-chip">@i</span></td>
                                    <td>
                                        <a asp-controller="Notice"
                                           asp-action="ViewPdf"
                                           asp-route-id="@n.Id"
                                           target="_blank"
                                           class="notice-title-link">
                                            <i class="fa-regular fa-file-lines"></i>
                                            <span>@n.Title</span>
                                        </a>
                                    </td>
                                    <td>
                                        <span class="notice-date-pill">
                                            <i class="fa-regular fa-calendar"></i>
                                            @n.PublishDate.ToString("dd MMM yyyy")
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <a asp-controller="Notice"
                                           asp-action="ViewPdf"
                                           asp-route-id="@n.Id"
                                           class="notice-pdf-btn"
                                           target="_blank">
                                            <i class="fa-solid fa-file-pdf"></i>
                                            <span>View PDF</span>
                                        </a>
                                    </td>
                                </tr>
                                i++;
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div id="noNoticeSearch" class="notice-empty d-none">
                <i class="fa-solid fa-magnifying-glass d-block"></i>
                <h6 class="fw-bold text-dark mb-1">কোনো বিজ্ঞপ্তি পাওয়া যায়নি</h6>
                <p class="small mb-0">অন্য কোনো শব্দ দিয়ে খুঁজে দেখুন।</p>
            </div>
        }
        else
        {
            <div class="notice-empty">
                <i class="fa-regular fa-folder-open d-block"></i>
                <h6 class="fw-bold text-dark mb-1">এখনো কোনো বিজ্ঞপ্তি প্রকাশিত হয়নি</h6>
                <p class="small mb-0">নতুন বিজ্ঞপ্তি প্রকাশিত হলে এখানে তালিকাভুক্ত হবে।</p>
            </div>
        }
    </div>

</div>

@section Scripts {
    <script>
        (function () {
            const input = document.getElementById("noticeSearchInput");
            const rows = document.querySelectorAll(".notice-row");
            const countEl = document.getElementById("noticeResultCount");
            const emptyEl = document.getElementById("noNoticeSearch");
            if (!input || !rows.length) return;

            input.addEventListener("input", function () {
                const q = this.value.trim().toLowerCase();
                let visible = 0;

                rows.forEach(row => {
                    const match = row.innerText.toLowerCase().includes(q);
                    row.style.display = match ? "" : "none";
                    if (match) visible++;
                });

                if (countEl) countEl.textContent = `Showing ${visible} notice(s)`;
                if (emptyEl) emptyEl.classList.toggle("d-none", visible > 0);
            });
        })();
    </script>
}
