@model CSS.Models.Notice
@{
    ViewData["Title"] = "Add Notice";
}

<link rel="stylesheet" href="~/css/notice.css" asp-append-version="true" />

<section class="notice-hero">
    <div class="container position-relative" style="z-index:2;">
        <div class="notice-breadcrumb">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <span>/</span>
            <a asp-action="Index">Notice Management</a>
            <span>/</span>
            <span>Add Notice</span>
        </div>
        <h1 class="notice-hero-title">Publish New Notice</h1>
        <p class="notice-hero-sub">Upload an official PDF document and publish it to the notice board.</p>
    </div>
</section>

<div class="container py-5">
    <div class="notice-form-card">
        <form asp-action="Create" enctype="multipart/form-data" method="post">
            <div asp-validation-summary="All" class="alert alert-danger rounded-3 small mb-3 @(ViewData.ModelState.IsValid ? "d-none" : "")"></div>

            <div class="mb-3">
                <label class="notice-label">Notice Title <span class="text-danger">*</span></label>
                <input asp-for="Title" class="form-control notice-input" placeholder="Enter notice title" required />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="notice-label">Publish Date <span class="text-danger">*</span></label>
                <input asp-for="PublishDate" type="date" class="form-control notice-input" required />
                <span asp-validation-for="PublishDate" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label class="notice-label">PDF Document <span class="text-danger">*</span></label>
                <label class="notice-pdf-drop w-100" for="noticePdfFile">
                    <i class="fa-solid fa-file-pdf fs-2 mb-2 d-block" style="color:var(--css-primary);"></i>
                    <span class="fw-semibold text-dark d-block" id="noticePdfLabel">Click to choose a PDF file</span>
                    <span class="small text-muted">Only .pdf files supported</span>
                    <input type="file" id="noticePdfFile" name="file" accept="application/pdf" class="d-none" required />
                </label>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn-css-primary px-4">
                    <i class="fa-solid fa-paper-plane"></i>
                    <span>Publish Notice</span>
                </button>
                <a asp-action="Index" class="btn btn-light border rounded-3 px-4 fw-semibold">
                    <i class="fa-solid fa-arrow-left me-1"></i> Back
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById("noticePdfFile").addEventListener("change", function (e) {
            const file = e.target.files[0];
            if (file) {
                document.getElementById("noticePdfLabel").textContent = file.name;
            }
        });
    </script>
}
