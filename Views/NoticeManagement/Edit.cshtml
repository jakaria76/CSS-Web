@model CSS.Models.Notice
@{
    ViewData["Title"] = "Edit Notice";
}

<link rel="stylesheet" href="~/css/notice.css" asp-append-version="true" />

<section class="notice-hero">
    <div class="container position-relative" style="z-index:2;">
        <div class="notice-breadcrumb">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <span>/</span>
            <a asp-action="Index">Notice Management</a>
            <span>/</span>
            <span>Edit Notice</span>
        </div>
        <h1 class="notice-hero-title">Edit Notice</h1>
        <p class="notice-hero-sub">Update notice title, publish date, or replace the attached PDF.</p>
    </div>
</section>

<div class="container py-5">
    <div class="notice-form-card">
        <form asp-action="Edit" enctype="multipart/form-data" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="All" class="alert alert-danger rounded-3 small mb-3 @(ViewData.ModelState.IsValid ? "d-none" : "")"></div>

            <div class="mb-3">
                <label class="notice-label">Notice Title <span class="text-danger">*</span></label>
                <input asp-for="Title" class="form-control notice-input" placeholder="Enter notice title" required />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="notice-label">Publish Date <span class="text-danger">*</span></label>
                <input asp-for="PublishDate" type="date" class="form-control notice-input" required />
                <span asp-validation-for="PublishDate" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label class="notice-label">Current File</label>
                <div class="d-flex align-items-center justify-content-between bg-light border p-3 rounded-3">
                    <div class="d-flex align-items-center gap-2 text-truncate">
                        <i class="fa-solid fa-file-pdf text-danger fs-5"></i>
                        <span class="fw-semibold text-dark text-truncate">@Model.FileName</span>
                    </div>
                    <a asp-controller="Notice" asp-action="ViewPdf" asp-route-id="@Model.Id" target="_blank" class="notice-pdf-btn">
                        Preview
                    </a>
                </div>
            </div>

            <div class="mb-4">
                <label class="notice-label">Replace PDF <span class="text-muted fw-normal">(Optional)</span></label>
                <label class="notice-pdf-drop w-100" for="noticeEditPdfFile">
                    <i class="fa-solid fa-cloud-arrow-up fs-3 mb-2 d-block" style="color:var(--css-primary);"></i>
                    <span class="fw-semibold text-dark d-block" id="noticeEditPdfLabel">Click to choose a new PDF (optional)</span>
                    <input type="file" id="noticeEditPdfFile" name="file" accept="application/pdf" class="d-none" />
                </label>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn-css-primary px-4">
                    <i class="fa-solid fa-floppy-disk"></i>
                    <span>Update Notice</span>
                </button>
                <a asp-action="Index" class="btn btn-light border rounded-3 px-4 fw-semibold">
                    <i class="fa-solid fa-arrow-left me-1"></i> Back
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById("noticeEditPdfFile").addEventListener("change", function (e) {
            const file = e.target.files[0];
            if (file) {
                document.getElementById("noticeEditPdfLabel").textContent = file.name;
            }
        });
    </script>
}
