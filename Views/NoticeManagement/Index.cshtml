@model IEnumerable<CSS.Models.Notice>
@{
    ViewData["Title"] = "Manage Notices";
    var notices = Model?.ToList() ?? new List<CSS.Models.Notice>();
}

<link rel="stylesheet" href="~/css/notice.css" asp-append-version="true" />

<!-- HERO -->
<section class="notice-hero">
    <div class="container position-relative" style="z-index:2;">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
            <div>
                <div class="notice-breadcrumb">
                    <a asp-controller="Home" asp-action="Index">Home</a>
                    <span>/</span>
                    <span>Notice Management</span>
                </div>
                <h1 class="notice-hero-title">Manage Notices</h1>
                <p class="notice-hero-sub">Create, update, preview, or remove official organization notices.</p>
            </div>

            <a asp-action="Create" class="btn-css-primary py-2 px-4">
                <i class="fa-solid fa-plus"></i>
                <span>Add Notice</span>
            </a>
        </div>
    </div>
</section>

<div class="container py-5">
    <div class="notice-board-card">
        <div class="notice-board-topbar">
            <span class="fw-semibold" style="color:var(--foreground);"><i class="fa-solid fa-list-check me-2" style="color:var(--css-primary);"></i>All Notices (@notices.Count)</span>
            <a asp-controller="Notice" asp-action="Index" class="btn-css-outline btn-sm px-3">
                Public View
            </a>
        </div>

        @if (notices.Any())
        {
            <div class="table-responsive">
                <table class="table notice-board-table align-middle">
                    <thead>
                        <tr>
                            <th style="width:65px;">SL</th>
                            <th>Title</th>
                            <th style="width:160px;">Publish Date</th>
                            <th style="width:260px;" class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int i = 1;
                            foreach (var n in notices)
                            {
                                <tr>
                                    <td><span class="notice-sl-chip">@i</span></td>
                                    <td class="fw-semibold text-dark">@n.Title</td>
                                    <td>
                                        <span class="notice-date-pill">
                                            <i class="fa-regular fa-calendar"></i>
                                            @n.PublishDate.ToString("dd MMM yyyy")
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div class="d-inline-flex flex-wrap gap-2 justify-content-end">
                                            <a asp-controller="Notice"
                                               asp-action="ViewPdf"
                                               asp-route-id="@n.Id"
                                               target="_blank"
                                               class="notice-pdf-btn">
                                                <i class="fa-solid fa-file-pdf"></i> PDF
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@n.Id"
                                               class="btn btn-sm btn-warning fw-semibold rounded-3 px-3">
                                                <i class="fa-solid fa-pen"></i> Edit
                                            </a>

                                            <form asp-action="Delete" method="post" class="d-inline notice-delete-form">
                                                <input type="hidden" name="id" value="@n.Id" />
                                                <button type="button"
                                                        class="btn btn-sm btn-danger fw-semibold rounded-3 px-3 notice-delete-btn">
                                                    <i class="fa-solid fa-trash"></i> Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                i++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="notice-empty">
                <i class="fa-regular fa-file-lines d-block"></i>
                <h6 class="fw-bold text-dark mb-1">No notices added yet</h6>
                <p class="small mb-3">Click "Add Notice" to publish your first PDF notice.</p>
                <a asp-action="Create" class="btn-css-primary btn-sm">
                    <i class="fa-solid fa-plus"></i>
                    <span>Add Notice</span>
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll(".notice-delete-btn").forEach(btn => {
            btn.addEventListener("click", function () {
                const form = this.closest("form");
                Swal.fire({
                    title: "Delete this notice?",
                    text: "This action cannot be undone.",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#D9232B",
                    cancelButtonColor: "#475569",
                    confirmButtonText: "Yes, delete it"
                }).then((result) => {
                    if (result.isConfirmed && form) {
                        form.submit();
                    }
                });
            });
        });
    </script>
}
